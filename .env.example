# AR MART — environment template
# Copy to .env at the monorepo root (same folder as this file) and fill in values.
# NEVER commit the real .env file.

# --- API (apps/api/src/env.ts reads these) ---
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/armart

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# Set to true when the API is served over HTTPS (secure cookies)
COOKIE_SECURE=false

# --- Web (Next.js) ---
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
